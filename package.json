{
  "name": "sparkagency-theme",
  "version": "1.0.0",
  "private": true,
  "description": "SCSS build for the standalone Spark Agency WordPress theme.",
  "author": "Spark Agency",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:styles && npm run build:blocks",
    "build:styles": "node resources/node-scripts/build-styles.js",
    "build:blocks": "wp-scripts build --source-path=src/blocks --output-path=build/blocks",
    "build:dev": "node resources/node-scripts/build-styles.js --expanded",
    "dev": "node resources/node-scripts/build-styles.js --watch --expanded",
    "dev:poll": "node resources/node-scripts/build-styles.js --watch --poll --expanded",
    "dev:blocks": "wp-scripts start --source-path=src/blocks --output-path=build/blocks",
    "create:block": "node resources/node-scripts/create-block.js"
  },
  "devDependencies": {
    "@wordpress/scripts": "36.1.0",
    "sass": "1.105.1"
  }
}
