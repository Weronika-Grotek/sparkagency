{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sparkagency/case-study-description-item",
  "version": "1.0.0",
  "title": "Sekcja opisu case study",
  "category": "design",
  "icon": "layout",
  "description": "Pojedyncza edytowalna sekcja opisu case study.",
  "textdomain": "sparkagency",
  "parent": ["sparkagency/case-study-description"],
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "showCounter": {
      "type": "boolean",
      "default": false
    },
    "counterValue": {
      "type": "integer",
      "default": 0
    },
    "counterPrefix": {
      "type": "string",
      "default": ""
    },
    "counterSuffix": {
      "type": "string",
      "default": ""
    },
    "counterLabel": {
      "type": "string",
      "default": ""
    },
    "counterDuration": {
      "type": "number",
      "default": 1200
    },
    "metrics": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false
  },
  "editorScript": "file:./index.jsx",
  "viewScript": "file:./view.js"
}
