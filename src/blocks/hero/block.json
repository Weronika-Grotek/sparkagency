{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sparkagency/hero",
	"version": "1.0.0",
	"title": "Spark Hero",
	"category": "design",
	"icon": "cover-image",
	"description": "Sekcja hero z treścią uzupełnianą w edytorze WordPress.",
	"textdomain": "sparkagency",
	"attributes": {
		"eyebrow": { "type": "string", "default": "" },
		"address": { "type": "string", "default": "" },
		"headline": { "type": "string", "default": "" },
		"theme": { "type": "string", "default": "inherit" },
		"brand": { "type": "string", "default": "agency" },
		"backgroundStyle": { "type": "string", "default": "brand" },
		"backgroundColor": { "type": "string", "default": "" },
		"showGraphic": { "type": "boolean", "default": false },
		"graphicId": { "type": "number", "default": 0 },
		"graphicUrl": { "type": "string", "default": "" },
		"graphicAlt": { "type": "string", "default": "" },
		"particleAnimation": { "type": "boolean", "default": true },
		"particleColor": { "type": "string", "default": "" },
		"particleGlowColor": { "type": "string", "default": "" },
		"lead": { "type": "string", "default": "" },
		"leadSecondary": { "type": "string", "default": "" },
		"showNavigation": { "type": "boolean", "default": false },
		"navigationRootLabel": { "type": "string", "default": "" },
		"navigationRootUrl": { "type": "string", "default": "" },
		"navigationCurrentLabel": { "type": "string", "default": "" },
		"showPrimaryButton": { "type": "boolean", "default": true },
		"showSecondaryButton": { "type": "boolean", "default": true },
		"primaryLabel": { "type": "string", "default": "" },
		"primaryUrl": { "type": "string", "default": "" },
		"secondaryLabel": { "type": "string", "default": "" },
		"secondaryUrl": { "type": "string", "default": "" }
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false
	},
	"editorScript": "file:./index.jsx",
	"viewScript": "file:./view.js"
}
