{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sparkagency/contact-full-form",
  "version": "1.0.0",
  "title": "Kontakt - pełny formularz",
  "category": "design",
  "icon": "feedback",
  "description": "Rozbudowany formularz na podstronę Kontakt, uzupełniany danymi z formularza skróconego.",
  "textdomain": "sparkagency",
  "attributes": {
    "title": { "type": "string", "default": "Opowiedz nam o projekcie" },
    "lede": { "type": "string", "default": "Napisz, czego potrzebujesz. Ustalimy właściwy zespół i kolejny krok." },
    "topics": { "type": "array", "default": [
      { "label": "Komunikacja na wiele rynków", "value": "warsaw", "color": "#43A0ED" },
      { "label": "Reklama i marketing dla sektora healthcare", "value": "health", "color": "#A857BC" },
      { "label": "Technologia dla biznesu", "value": "exp", "color": "#01B57C" },
      { "label": "Produkcja i postprodukcja video", "value": "studio", "color": "#D65251" },
      { "label": "Packaging i artwork production", "value": "works", "color": "#D8AB52" },
      { "label": "Nie wiem, doradźcie", "value": "advice", "color": "#FFFFFF" }
    ] },
    "addressLabel": { "type": "string", "default": "Adres" },
    "address": { "type": "string", "default": "ul. Cybernetyki 19\n02-677 Warszawa" },
    "mapUrl": { "type": "string", "default": "https://www.google.com/maps/search/?api=1&query=Cybernetyki+19+Warszawa" },
    "mapLabel": { "type": "string", "default": "Otwórz w Mapach Google" },
    "contactTitle": { "type": "string", "default": "Nowe projekty" },
    "contactEmail": { "type": "string", "default": "kontakt@sparkagency.pl" },
    "contactPhone": { "type": "string", "default": "[telefon do uzupełnienia]" },
    "contactHours": { "type": "string", "default": "pon–pt 9:00–17:00" },
    "teamsTitle": { "type": "string", "default": "Zespoły" },
    "departments": { "type": "array", "default": [
      { "key": "works", "name": "sparkWORKS", "email": "kontakt@sparkworks.pl", "color": "#D8AB52" },
      { "key": "exp", "name": "sparkEXP", "email": "kontakt@sparkexp.pl", "color": "#01B57C" },
      { "key": "warsaw", "name": "sparkWARSAW", "email": "kontakt@sparkwarsaw.pl", "color": "#43A0ED" },
      { "key": "health", "name": "sparkHEALTH", "email": "kontakt@sparkhealth.pl", "color": "#A857BC" },
      { "key": "studio", "name": "sparkSTUDIO", "email": "kontakt@sparkstudio.pl", "color": "#D65251" }
    ] },
    "privacyUrl": { "type": "string", "default": "/polityka-prywatnosci/" },
    "successMessage": { "type": "string", "default": "Dziękujemy! Twoja wiadomość została wysłana." }
  },
  "supports": { "align": ["wide", "full"], "anchor": true, "spacing": { "margin": ["top", "bottom"], "padding": ["top", "bottom"] }, "html": false },
  "editorScript": "file:./index.jsx",
  "viewScript": "file:./view.js"
}
