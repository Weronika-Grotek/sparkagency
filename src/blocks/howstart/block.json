    "ctaUrl": { "type": "string", "default": "" },
    "theme": { "type": "string", "default": "dark" },
    "accentColor": { "type": "string", "default": "" },
    "titleFontSize": { "type": "string", "default": "" },
    "steps": { "type": "array", "default": [] }
