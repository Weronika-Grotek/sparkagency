{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sparkagency/howstart",
  "version": "1.0.0",
  "title": "Spark How Start",
  "category": "design",
  "icon": "list-view",
  "description": "Edytowalna sekcja „Jak zacząć” z krokami procesu.",
  "textdomain": "sparkagency",
