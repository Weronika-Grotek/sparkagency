{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sparkagency/career-single-header",
	"version": "1.0.0",
	"title": "Spark Kariera: nagłówek oferty",
	"category": "design",
	"icon": "cover-image",
	"description": "Dynamiczny nagłówek bieżącej oferty pracy z danymi i linkami.",
	"textdomain": "sparkagency",
	"attributes": {
		"homeLabel": { "type": "string", "default": "Start" },
		"careerLabel": { "type": "string", "default": "Kariera" },
		"applyLabel": { "type": "string", "default": "Aplikuj" },
		"allOffersLabel": { "type": "string", "default": "Wszystkie oferty" }
	},
	"supports": { "align": ["full"], "anchor": true, "html": false },
	"editorScript": "file:./index.js"
}
