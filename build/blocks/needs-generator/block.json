{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sparkagency/needs-generator",
  "version": "1.0.0",
  "title": "SparkGenerator",
  "category": "design",
  "icon": "forms",
  "description": "Kreator potrzeb: firma, informacja i zakres z przekierowaniem do formularza kontaktowego.",
  "textdomain": "sparkagency",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "02 · Generator potrzeb"
    },
    "title": {
      "type": "string",
      "default": "Znajdź właściwy punkt startu."
    },
    "lede": {
      "type": "string",
      "default": "Odpowiedz na krótkie pytania. Na ich podstawie pokażemy zespół, od którego najlepiej zacząć rozmowę."
    },
    "finalUrl": {
      "type": "string",
      "default": ""
    },
    "finalButtonLabel": {
      "type": "string",
      "default": "Przejdź do briefu"
    },
    "steps": {
      "type": "array",
      "default": [
        {
          "title": "Co chcesz zrobić?",
          "param": "company",
          "markerMode": "brand",
          "options": []
        },
        {
          "title": "Skala zadania",
          "param": "information",
          "markerMode": "letters",
          "options": []
        },
        {
          "title": "Czego potrzebujesz?",
          "param": "scope",
          "markerMode": "letters",
          "options": []
        }
      ]
    },
    "serviceGroups": {
      "type": "array",
      "default": [
        {
          "id": "warsaw",
          "title": "Spark Warsaw",
          "categories": [
            "Kreacja",
            "Kampanie",
            "Broszury",
            "POS",
            "Outdoor",
            "Digital",
            "Retusz",
            "DTP",
            "Adaptacje",
            "Lokalizacja",
            "Multi-market"
          ]
        },
        {
          "id": "exp",
          "title": "Spark EXP",
          "categories": [
            "CLM",
            "RTE",
            "Strony WWW",
            "Aplikacje",
            "Platformy",
            "Software",
            "Integracje",
            "Automatyzacja",
            "AI",
            "MVP",
            "Maintenance"
          ]
        },
        {
          "id": "health",
          "title": "Spark Health",
          "categories": [
            "HCP",
            "Pacjenci",
            "Farmaceuci",
            "Strategia",
            "Medical",
            "Kreacja",
            "Medical writing",
            "Digital",
            "Omnichannel",
            "Disease awareness"
          ]
        },
        {
          "id": "works",
          "title": "Spark Works",
          "categories": [
            "Packaging",
            "Artwork",
            "Master artwork",
            "Adaptacje",
            "Wersjonowanie",
            "Prepress",
            "Print-ready",
            "QA",
            "Multi-SKU",
            "Rollout"
          ]
        },
        {
          "id": "studio",
          "title": "Spark Studio",
          "categories": [
            "Spoty",
            "Video",
            "Produkcja",
            "Postprodukcja",
            "Motion",
            "2D",
            "3D",
            "CGI",
            "Compositing",
            "Social video",
            "Cutdowns"
          ]
        }
      ]
    },
    "companies": {
      "type": "array",
      "default": []
    },
    "results": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": [
        "top",
        "bottom"
      ]
    },
    "html": false
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js"
}