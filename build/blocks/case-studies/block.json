{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sparkagency/case-studies",
  "version": "1.0.0",
  "title": "Spark Case Studies",
  "category": "design",
  "icon": "portfolio",
  "description": "Pozioma lista realizacji pobierana z wpisów case study.",
  "textdomain": "sparkagency",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "05 · Nasza praca"
    },
    "title": {
      "type": "string",
      "default": "Zobacz, jak pracują różne kompetencje."
    },
    "lede": {
      "type": "string",
      "default": "Case studies, w których strategia, design i technologia spotykają się w konkretnych rezultatach."
    },
    "postType": {
      "type": "string",
      "default": "case-study"
    },
    "postsPerPage": {
      "type": "number",
      "default": 5
    },
    "brandTaxonomy": {
      "type": "string",
      "default": ""
    },
    "clientMetaKey": {
      "type": "string",
      "default": "client"
    },
    "metricValueMetaKey": {
      "type": "string",
      "default": "metric_value"
    },
    "metricLabelMetaKey": {
      "type": "string",
      "default": "metric_label"
    },
    "allUrl": {
      "type": "string",
      "default": ""
    },
    "allLabel": {
      "type": "string",
      "default": "Wszystkie realizacje"
    },
    "contactUrl": {
      "type": "string",
      "default": ""
    },
    "contactLabel": {
      "type": "string",
      "default": "Porozmawiajmy o Twoim projekcie"
    },
    "contactNewTab": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": [
        "top",
        "bottom"
      ]
    },
    "html": false
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js"
}